---
export type Props = {
  value: string
  template?: string
}

const { value, template } = Astro.props

// A template without "%s" gives the title unchanged. A replacer function keeps
// "$&" and other "$" patterns in the title as text.
const title =
  template && template.includes("%s")
    ? template.replace("%s", () => {
        return value
      })
    : value
---

<title>{title}</title>

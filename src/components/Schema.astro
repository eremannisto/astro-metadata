---
import type { SchemaData } from "../lib/schema.ts"

export type { SchemaData }

export type Props = {
  data: SchemaData | SchemaData[]
}

const { data } = Astro.props

// Escape the characters that can end the script tag or break the JavaScript parser.
// A value such as "</script>" in the schema then stays inside the JSON.
const json = JSON.stringify(data)
  .replace(/</g, "\\u003c")
  .replace(/>/g, "\\u003e")
  .replace(/&/g, "\\u0026")
  .replace(/\u2028/g, "\\u2028")
  .replace(/\u2029/g, "\\u2029")
---

<script is:inline type="application/ld+json" set:html={json} />

---
import { getConfig, localize } from "../lib/config.ts"
import {
  isoDate,
  pageCanonical,
  pageDescription,
  pageHreflang,
  pageImage,
  pageLocale,
  pageOpenGraphLocales,
} from "../lib/page.ts"
import type { MetadataProps } from "../lib/page.ts"
import { url } from "../lib/url.ts"

export type Props = Pick<
  MetadataProps,
  | "title"
  | "description"
  | "image"
  | "type"
  | "published"
  | "modified"
  | "canonical"
  | "hreflang"
  | "locale"
>

const props = Astro.props
const locale = pageLocale(Astro, props)
const siteName = localize(getConfig().siteName, locale)
const description = pageDescription(props, locale)
const image = pageImage(props, locale)
const locales = pageOpenGraphLocales(locale, pageHreflang(Astro, props))
const article = props.type === "article"

// Social cards show the page title without the template: og:site_name has the site name
const title = props.title ?? siteName
---

{title && <meta property="og:title" content={title} />}
{description && <meta property="og:description" content={description} />}
<meta property="og:url" content={pageCanonical(Astro, props)} />
<meta property="og:type" content={props.type ?? "website"} />
{siteName && <meta property="og:site_name" content={siteName} />}
{locales.locale && <meta property="og:locale" content={locales.locale} />}
{
  locales.alternates.map((alternate) => {
    return <meta property="og:locale:alternate" content={alternate} />
  })
}
{
  image && (
    <>
      <meta property="og:image" content={url(image.url)} />
      {image.alt && <meta property="og:image:alt" content={image.alt} />}
      {image.width && <meta property="og:image:width" content={String(image.width)} />}
      {image.height && <meta property="og:image:height" content={String(image.height)} />}
    </>
  )
}
{
  article && props.published && (
    <meta property="article:published_time" content={isoDate(props.published)} />
  )
}
{
  article && props.modified && (
    <meta property="article:modified_time" content={isoDate(props.modified)} />
  )
}

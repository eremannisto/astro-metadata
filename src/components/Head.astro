---
import type { ComponentProps } from "astro/types"

import { getConfig, localize } from "../lib/config.ts"
import type { ThemeColor } from "../lib/config.ts"
import { manifestUrl } from "../lib/manifest.ts"
import { url, withBase } from "../lib/url.ts"
import Alternates from "./Alternates.astro"
import type { Feed, LanguageAlternate } from "./Alternates.astro"
import Canonical from "./Canonical.astro"
import Description from "./Description.astro"
import Icons from "./Icons.astro"
import OpenGraph from "./OpenGraph.astro"
import type { OpenGraphImage } from "./OpenGraph.astro"
import Robots from "./Robots.astro"
import Schema from "./Schema.astro"
import type { SchemaData } from "./Schema.astro"
import Title from "./Title.astro"
import Twitter from "./Twitter.astro"

export type Props = {
  title?: string
  titleTemplate?: string
  description?: string | false
  canonical?: string | false
  charset?: string
  viewport?: string
  image?: OpenGraphImage | false
  robots?: ComponentProps<typeof Robots> | false
  openGraph?: ComponentProps<typeof OpenGraph> | false
  twitter?: ComponentProps<typeof Twitter> | false
  icons?: ComponentProps<typeof Icons> | false
  schema?: SchemaData | SchemaData[] | false
  languages?: LanguageAlternate[] | false
  feeds?: Feed[] | false
  themeColor?: ThemeColor | false
  colorScheme?: string | false
  manifest?: string | false
  /** The locale for localized config values. Defaults to `Astro.currentLocale`. */
  locale?: string
}

const {
  title,
  titleTemplate,
  description,
  canonical,
  charset = "UTF-8",
  viewport = "width=device-width, initial-scale=1.0",
  image,
  robots,
  openGraph,
  twitter,
  icons,
  schema,
  languages,
  feeds,
  themeColor,
  colorScheme,
  manifest,
  locale = Astro.currentLocale,
} = Astro.props

const enabled = <T,>(value: T | false | undefined): value is T => {
  return value !== false && value !== undefined
}

// Site-wide defaults from src/metadata.config.ts. Props override them.
const config = getConfig()
const siteName = localize(config.siteName, locale)
const template = titleTemplate ?? localize(config.titleTemplate, locale)
const pageDescription = description ?? localize(config.description, locale)
const pageImage = image ?? config.image
const pageRobots = robots ?? config.robots
const pageManifest = manifest ?? manifestUrl(config, locale)
const pageThemeColor = themeColor ?? config.themeColor
const pageColorScheme = colorScheme ?? config.colorScheme
const pageFeeds =
  feeds ??
  config.feeds?.map((feed) => {
    return { ...feed, title: localize(feed.title, locale) }
  })

// The canonical URL of the page: the prop, or the absolute URL of the current page
const canonicalUrl = canonical === false ? undefined : url(canonical ?? Astro.url.pathname)

const og =
  openGraph !== false
    ? {
        title: title ?? siteName,
        siteName,
        description: enabled(pageDescription) ? pageDescription : undefined,
        image: enabled(pageImage) ? pageImage : undefined,
        url: canonicalUrl,
        ...openGraph,
      }
    : false

const tw =
  twitter !== false
    ? {
        ...config.twitter,
        title: title ?? siteName,
        description: enabled(pageDescription) ? pageDescription : undefined,
        image: enabled(pageImage) ? pageImage : undefined,
        ...twitter,
      }
    : false
---

<head>
  <meta charset={charset} />
  <slot name="top" />
  <meta name="viewport" content={viewport} />
  {
    enabled(pageThemeColor) &&
      (typeof pageThemeColor === "string" ? (
        <meta name="theme-color" content={pageThemeColor} />
      ) : (
        <>
          <meta
            name="theme-color"
            content={pageThemeColor.light}
            media="(prefers-color-scheme: light)"
          />
          <meta
            name="theme-color"
            content={pageThemeColor.dark}
            media="(prefers-color-scheme: dark)"
          />
        </>
      ))
  }
  {enabled(pageColorScheme) && <meta name="color-scheme" content={pageColorScheme} />}

  {title ? <Title value={title} template={template} /> : siteName && <Title value={siteName} />}

  {enabled(pageDescription) && <Description value={pageDescription} />}
  {canonicalUrl && <Canonical value={canonicalUrl} />}
  {enabled(pageRobots) && <Robots {...pageRobots} />}
  {enabled(og) && <OpenGraph {...og} />}
  {enabled(tw) && <Twitter {...tw} />}
  {icons !== false && <Icons {...icons} />}
  {enabled(pageManifest) && <link rel="manifest" href={withBase(pageManifest)} />}
  {enabled(schema) && <Schema data={schema} />}
  <Alternates
    languages={enabled(languages) ? languages : undefined}
    feeds={enabled(pageFeeds) ? pageFeeds : undefined}
  />

  <slot />
</head>

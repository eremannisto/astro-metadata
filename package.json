{
  "name": "@mannisto/astro-metadata",
  "version": "2.0.0-alpha.3",
  "description": "Metadata for Astro: page tags, social cards, favicons, the web app manifest and structured data.",
  "license": "MIT",
  "type": "module",
  "homepage": "https://github.com/eremannisto/astro-metadata#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eremannisto/astro-metadata.git"
  },
  "bugs": {
    "url": "https://github.com/eremannisto/astro-metadata/issues"
  },
  "keywords": [
    "astro-component",
    "astro",
    "seo",
    "metadata"
  ],
  "exports": {
    ".": {
      "types": "./src/integration.d.ts",
      "default": "./src/integration.js"
    },
    "./runtime": "./src/runtime.ts",
    "./components": "./src/components/index.ts"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "lint": "eslint . --fix",
    "format": "prettier --write .",
    "check": "eslint . && prettier --check .",
    "test": "pnpm run test:unit && pnpm run test:e2e",
    "test:unit": "vitest run",
    "test:e2e": "pnpm test:fixtures && playwright test",
    "test:fixtures": "pnpm --filter \"./tests/e2e/fixtures/**\" exec astro build"
  },
  "peerDependencies": {
    "astro": "^6.4.6 || ^7.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.5",
    "astro": "^7.3.5",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^0.14.1",
    "sharp": "^0.35.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@10.32.1",
  "dependencies": {
    "lit": "^3.3.3",
    "schema-dts": "^2.0.0"
  }
}
